root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json,js,mjs,ts,mts,vue,css,html,svg}]
indent_size = 2

[frontend/**.{ts,vue}]
max_line_length = 100

[*.md]
trim_trailing_whitespace = false
